funcionarios = []
resultados = []

for i in range(10):
    nome = input("Digite o nome: ")
    salario = float(input("Digite o salário bruto: R$ "))
    genero = input("Digite o gênero (M/F): ").upper()

    funcionarios.append([nome, salario, genero])


for i in range(10):

    salario_liquido = funcionarios[i][1] * 0.84

    if salario_liquido < 7298.97:
        vale = 729.87
    else:
        vale = 499.78

    total = salario_liquido + vale

    resultados.append([salario_liquido, vale, total])


masculino = 0
feminino = 0

maior_liquido = resultados[0][0]
menor_liquido = resultados[0][0]

maior_masculino = 0
maior_feminino = 0


for i in range(10):

    print("\nFuncionário:", funcionarios[i][0])
    print("Salário líquido: R$", round(resultados[i][0], 2))
    print("Vale alimentação: R$", round(resultados[i][1], 2))
    print("Salário líquido + vale: R$", round(resultados[i][2], 2))

    if funcionarios[i][2] == "M":
        masculino += 1

        if resultados[i][0] > maior_masculino:
            maior_masculino = resultados[i][0]

    elif funcionarios[i][2] == "F":
        feminino += 1

        if resultados[i][0] > maior_feminino:
            maior_feminino = resultados[i][0]

    if resultados[i][0] > maior_liquido:
        maior_liquido = resultados[i][0]

    if resultados[i][0] < menor_liquido:
        menor_liquido = resultados[i][0]


print("\n===== RESULTADO FINAL =====")
print("Funcionários masculinos:", masculino)
print("Funcionários femininos:", feminino)
print("Maior salário líquido: R$", round(maior_liquido, 2))
print("Menor salário líquido: R$", round(menor_liquido, 2))
print("Maior salário líquido masculino: R$", round(maior_masculino, 2))
print("Maior salário líquido feminino: R$", round(maior_feminino, 2))
