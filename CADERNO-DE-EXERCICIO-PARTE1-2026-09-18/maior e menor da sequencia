maior = None
menor = None
for i in range(5):
    num = int(input(f"Digite o {i+1}º número: "))
    if i == 0:
        maior = num
        menor = num
    else:
        if num > maior:
            maior = num
        if num < menor:
            menor = num
print(f"Maior valor: {maior} | Menor valor: {menor}")
